# GridPulse configuration - environment variables only (spec 9).
# Copy to .env (never commit .env). All variables are optional unless noted.

# --- Core --------------------------------------------------------------------
# SQLAlchemy async URL of PostgreSQL + TimescaleDB. "memory://" = in-memory (tests/demo only).
GRIDPULSE_DATABASE_URL=postgresql+asyncpg://gridpulse:gridpulse@localhost:5432/gridpulse
# Password of the compose database user (deploy/docker-compose.yml).
POSTGRES_PASSWORD=gridpulse
# 1 = load synthetic demo data and never call external sources (screenshots, E2E, offline).
GRIDPULSE_DEMO=0
GRIDPULSE_LOG_LEVEL=INFO
# JSON logs (1) or human-readable console logs (0).
GRIDPULSE_LOG_JSON=1

# --- Data sources --------------------------------------------------------------
# ENTSO-E Transparency Platform security token (free registration). Without it the
# ENTSO-E adapter is disabled and everything else keeps working.
GRIDPULSE_ENTSOE_TOKEN=
GRIDPULSE_HTTP_TIMEOUT_SECONDS=30
GRIDPULSE_INGEST_INTERVAL_MINUTES=15
GRIDPULSE_FREQUENCY_INTERVAL_MINUTES=1
GRIDPULSE_WEATHER_INTERVAL_MINUTES=60
# Hours re-fetched on every run (late corrections are upserted idempotently).
GRIDPULSE_BACKFILL_HOURS=48
GRIDPULSE_FORECAST_HORIZON_HOURS=48

# --- API -------------------------------------------------------------------------
GRIDPULSE_API_HOST=0.0.0.0
GRIDPULSE_API_PORT=8000
# Comma-separated list of allowed browser origins.
GRIDPULSE_CORS_ORIGINS=http://localhost:3000
GRIDPULSE_RATE_LIMIT_PER_MINUTE=120
# Require X-API-Key on every /api/v1 request (keys are stored as SHA-256 hashes).
GRIDPULSE_REQUIRE_API_KEY=0
# Enables POST /api/v1/alerts/test (UI test button). Leave empty to disable.
GRIDPULSE_ADMIN_TOKEN=
# Trust X-Forwarded-For (only behind your own reverse proxy).
GRIDPULSE_TRUST_PROXY_HEADERS=0
GRIDPULSE_MAX_PAGE_SIZE=10000
GRIDPULSE_MAX_EXPORT_ROWS=500000

# --- Retention (TimescaleDB policies) -----------------------------------------------
GRIDPULSE_RETENTION_RAW_DAYS=730
GRIDPULSE_RETENTION_FREQUENCY_DAYS=30
GRIDPULSE_COMPRESS_AFTER_DAYS=7

# --- Rule thresholds (see docs/rules.md) ---------------------------------------------
GRIDPULSE_FREQ_YELLOW_MHZ=100
GRIDPULSE_FREQ_CRITICAL_MHZ=200
GRIDPULSE_FORECAST_ERROR_RELATIVE=0.10
GRIDPULSE_PRICE_SPIKE_WARNING=500
GRIDPULSE_PRICE_SPIKE_CRITICAL=1000
GRIDPULSE_STALE_AFTER_HOURS=3
GRIDPULSE_DUNKELFLAUTE_SHARE=0.10
GRIDPULSE_DUNKELFLAUTE_MIN_HOURS=6
GRIDPULSE_CROSSCHECK_TOLERANCE=0.05
GRIDPULSE_STAT_THRESHOLD=4

# --- Plausibility (spec 7.4) -------------------------------------------------------
GRIDPULSE_PV_NIGHT_TOLERANCE_MW=50
GRIDPULSE_BALANCE_TOLERANCE=0.15
GRIDPULSE_PRICE_MIN_EUR_MWH=-500
GRIDPULSE_PRICE_MAX_EUR_MWH=4000

# --- Alerts --------------------------------------------------------------------------
GRIDPULSE_ALERT_MIN_SEVERITY=warning
GRIDPULSE_ALERT_DEBOUNCE_MINUTES=60
# Comma-separated generic JSON webhook URLs (treated as secrets, never logged).
GRIDPULSE_ALERT_WEBHOOK_URLS=
GRIDPULSE_SMTP_HOST=
GRIDPULSE_SMTP_PORT=587
GRIDPULSE_SMTP_USER=
GRIDPULSE_SMTP_PASSWORD=
GRIDPULSE_SMTP_FROM=gridpulse@localhost
GRIDPULSE_SMTP_TO=
GRIDPULSE_SMTP_STARTTLS=1

# --- Web (Next.js) ---------------------------------------------------------------------
# Where the web container reaches the API (server side only).
GRIDPULSE_API_URL=http://api:8000
GRIDPULSE_WEB_PORT=3000
