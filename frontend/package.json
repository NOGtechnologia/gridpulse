{
  "name": "gridpulse-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev -p 3000",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start -p 3000",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/lib/api/schema.ts && prettier --write src/lib/api/schema.ts",
    "generate:api:check": "openapi-typescript ../docs/openapi.json -o .api-check.ts && prettier --write .api-check.ts && node scripts/compare-files.mjs .api-check.ts src/lib/api/schema.ts",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;CC-BY-4.0;BlueOak-1.0.0;Python-2.0;MPL-2.0;Unlicense\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "license-checker-rseidelsohn": "5.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.31"
    }
  }
}
